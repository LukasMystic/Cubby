  "entry_point": {
    "file": "opening.json",
    "node_id": "opening_setup_001"
  },
  "decisions": [
    {
      "decision_id": "decision_001_initial_space_response",
      "source_file": "opening.json",
      "prompt": "What should Joey do after Mia says she feels squished?",
      "routes": [
        {
          "option": "A",
          "choice_text": "Sit down right next to Mia anyway",
          "target_file": "1.json"
        },
        {
          "option": "B",
          "choice_text": "Insist and ask again",
          "target_file": "2.json"
        },
        {
          "option": "C",
          "choice_text": "Accept it and ask",
          "target_file": "3.json"
        }
      ]
    },
    {
      "decision_id": "decision_002_after_option_a",
      "source_file": "1.json",
      "prompt": "Mia moved a little farther away. What should Joey do now?",
      "routes": [
        {
          "option": "A",
          "choice_text": "Notice Mia moved away and ask",
          "target_file": "1A.json"
        },
        {
          "option": "B",
          "choice_text": "Move closer to see the piece",
          "target_file": "1B.json"
        },
        {
          "option": "C",
          "choice_text": "Reach over and take a piece from Mia's pile without asking",
          "target_file": "1C.json"
        }
      ]
    },
    {
      "decision_id": "decision_003_after_option_b",
      "source_file": "2.json",
      "prompt": "Mia still seems tense. What should Joey do now?",
      "routes": [
        {
          "option": "A",
          "choice_text": "Notice Mia seems tense and ask",
          "target_file": "2A.json"
        },
        {
          "option": "B",
          "choice_text": "Keep sitting close",
          "target_file": "2B.json"
        },
        {
          "option": "C",
          "choice_text": "Lean in even closer to grab more blocks",
          "target_file": "2C.json"
        }
      ]
    },
    {
      "decision_id": "decision_004_after_option_c",
      "source_file": "3.json",
      "prompt": "Joey sees a perfect piece in Mia's area. What should he do?",
      "routes": [
        {
          "option": "A",
          "choice_text": "Pause and ask first",
          "target_file": "3A.json"
        },
        {
          "option": "B",
          "choice_text": "Lean in close",
          "target_file": "3B.json"
        },
        {
          "option": "C",
          "choice_text": "Reach over and take the piece Mia was using",
          "target_file": "3C.json"
        }
      ]
    },
    {
      "decision_id": "decision_005_after_option_3B",
      "source_file": "3B.json",
      "prompt": "Mia leans away after Joey gets too close. What should Joey do?",
      "routes": [
        {
          "option": "i",
          "choice_text": "Notice and move away a little bit",
          "target_file": "3b(i).json"
        },
        {
          "option": "ii",
          "choice_text": "Ignore it",
          "target_file": "3b(ii).json"
        }
      ]
    }
  ],
